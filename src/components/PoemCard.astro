---
import { sentences } from "../data/sentences";

const shuffled = sentences.sort(() => 0.5 - Math.random());
let selected = shuffled.slice(0, 5);
---

<div class="box">
  <p>
    {selected[0]}
    <br />
    {selected[1]}
    <br />
    {selected[2]}
    <br />
    {selected[3]}
    <br />
    {selected[4]}
  </p>
</div>

<style>
  div {
    border: solid 1px var(--green-text);
    padding: 0.5rem 2rem;
    border-radius: 10px;
  }
</style>
