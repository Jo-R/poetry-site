---
import RandomStanza from "../components/RandomStanza.astro";
import MySiteLayout from "../layouts/MainLayout.astro";
---

<MySiteLayout>
  <div>
    <h1>Jo Rigg</h1>
    <p class="intro-text">Code | Words | Sound</p>
  </div>
  <div class="poem-wrapper">
    <RandomStanza />
    <p class="explanation">
      A series of lines culled from my recent notebooks. Selected at random when
      the page loads.
    </p>
  </div>
</MySiteLayout>

<style>
  .poem-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: max-content;
  }

  .explanation {
    font-size: 10px;
  }
</style>

<script>
  import { gsap } from "gsap";
  gsap.from(".box", {
    x: 200,
    duration: 2,
    stagger: 1,
    delay: 3,
    opacity: 0,
  });
  gsap.from(".explanation", { x: 200, delay: 7, opacity: 0 });
  gsap.from(".intro-text", { x: -500, delay: 2 });
</script>
