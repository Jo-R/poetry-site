---
import PoemCard from "../components/PoemCard.astro";
import MySiteLayout from "../layouts/MainLayout.astro";
---

<MySiteLayout>
  <div>
    <h1>Hi poetry thing</h1>
    <p class="intro-text">So I guess here are some poems and things</p>
  </div>
  <div class="poem-wrapper">
    <PoemCard />
    <PoemCard />
    <PoemCard />
  </div>
</MySiteLayout>

<style>
  .poem-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: max-content;
  }
</style>

<script>
  import { gsap } from "gsap";
  // console.log("using GSAP: ", gsap.version);
  gsap.from(".box", {
    x: 200,
    duration: 2,
    stagger: 1,
    delay: 3,
    opacity: 0,
  });
  gsap.to("h1", { rotate: 360, duration: 2 });
  gsap.from(".intro-text", { x: -500, delay: 2 });
</script>
